# Reference only. The backend reads environment variables, not this file.
HRM_ENV=development
HRM_DB_PATH=./data/hrm_dev.sqlite3
# To select an EXTERNALLY MIGRATED local PostgreSQL development database,
# provide HRM_DATABASE_URL; it takes precedence over HRM_DB_PATH.
# HRM_DATABASE_URL=postgresql://local_user:local_password@127.0.0.1:5432/hrm_dev
HRM_JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Independent random secret for the platform administration token audience.
# If not set, the platform admin endpoints return 503 and remain disabled.
HRM_PLATFORM_JWT_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Leave blank for native mobile-only local testing.
HRM_CORS_ORIGINS=
# For transactional encrypted email queue, generate a 32-byte random key and
# store its 64-character hexadecimal form ONLY in backend secret management.
# The key must survive backend/worker restarts and must not be committed.
# HRM_MAIL_OUTBOX_KEY=SET_A_RANDOM_64_HEX_CHARACTER_VALUE
# IMPORTANT: OFF until trial duration, renewal, suspension and seat limits are
# explicitly approved. When on, expired/past_due companies lose HRM access.
HRM_ENFORCE_SUBSCRIPTIONS=0
# Optional: if not configured, one-time codes are written to private LOCAL
# development outboxes: verification-outbox.txt, invitation-outbox.txt,
# reset-outbox.txt. Never commit or use with real employee data.
# HRM_SMTP_HOST=smtp.example.com
# HRM_SMTP_PORT=465
# HRM_SMTP_USERNAME=example-account
# HRM_SMTP_PASSWORD=REPLACE_WITH_REAL_SECRET
# HRM_SMTP_FROM=verification@example.com
